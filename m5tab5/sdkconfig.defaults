# Deltas from the ESP32-P4 defaults; the board ones are the same as the
# other Tab5 projects'.

CONFIG_IDF_TARGET="esp32p4"

# Tab5 silicon is ESP32-P4 rev v1.3; without this the build targets v3.1+
# and esptool refuses to flash.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Console, logs and the file protocol all on the USB-C port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The framebuffer (gfx's 1.8 MB shadow) lives in PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Keeps the bootloader under 0x6000, so the table stays at 0x8000.
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y

# How a reset gets back to the launcher. The launcher marks app2 NEW when
# it boots it; this bootloader boots a NEW app once (as PENDING_VERIFY),
# and at the next reset, finding it still unconfirmed, marks it ABORTED
# and falls back to factory -- the launcher. An app that confirms itself
# (esp_ota_mark_app_valid_cancel_rollback(), automatic in an IDF app built
# with rollback on) keeps booting instead; erasing otadata (0xe000, 0x2000)
# from the ROM bootloader brings the launcher back. See README.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Long, UTF-8 file names on the card.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Two volumes, the card and a USB drive. One, and the second mount fails
# with nothing on screen to say so.
CONFIG_FATFS_VOLUME_COUNT=2

# 0039: FatFs's fast seek, which the ABI's storage section requires
# since its version 2 (feckless-libs' 5003; configure fails without it):
# an app's FIL has a cltbl, and Errant's and Spurious's readers map a
# large file's clusters with it.
CONFIG_FATFS_USE_FASTSEEK=y

# USB host, as defeatist-music-player-for-m5tab5 has it: drives behind a
# hub, the enumeration filter feckless_drivers' usbhost.c hooks, and the
# host's DMA buffers allowed in PSRAM (internal DMA memory is scarce).
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y
CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK=y
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024

CONFIG_FREERTOS_HZ=1000
# 0037: an .elf app's app_main() runs on this task, from the menu, so
# this is the stack it gets. Unprofitable Mahjong runs its game loop
# there on 16 KB in its own firmware; 8 KB was the menu's.
# 0049: 24 KB, Defeatist Music Player's own main task. It decodes on this
# task, and esp_audio_codec's decoders want about 20 KB of stack in the
# task that calls them (Defeatist's sdkconfig.defaults); its radio path
# checks for NETDEC_MIN_STACK, 24576, and refuses a stream below it.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# 0049: esp_audio_codec, linked for the ABI's audio section. Which decoders
# esp_audio_dec_register_default() registers is this launcher's
# configuration, not the app's, and each one is code here. Off: the ones
# Defeatist turns off in its own firmware (MP3 is its minimp3; it plays no
# G.711, AMR, SBC, LC3 or G.722). On, as the component defaults them: AAC,
# FLAC, Opus, Vorbis, ADPCM, ALAC and PCM, and the WAV, M4A, TS and Ogg
# parsers. An app that wants one of these off ones needs it on here.
CONFIG_AUDIO_DECODER_MP3_SUPPORT=n
CONFIG_AUDIO_DECODER_G711_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n

# 0023: .elf apps, run with feckless-abi-for-m5tab5's esp_elf loader.
# esp_elf runs them from PSRAM; memory protection off, as elf_loader's
# PSRAM examples have it (feckless_abi fails the build otherwise). The
# 256 KB L2 for code running from PSRAM, as Lothesome has it.
CONFIG_ELF_LOADER_LOAD_PSRAM=y
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
# 0037: this firmware's code from PSRAM too, so a flash write -- an
# app's save to NVS, or an install -- no longer stalls it. An .elf app
# runs from PSRAM already, but calls gfx, the panel and the rest here;
# Unprofitable Mahjong's saves flashed the panel cyan until its own
# firmware turned this on (its "code from PSRAM" patch), and on
# Avoidant they would again.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# 0023: an app's USB microphone through this firmware's UAC driver: with
# the default 4, one that lists five sample rates loses the fifth
# (Lothesome's 0027, the Blue Snowball's 48 kHz).
CONFIG_UAC_FREQ_NUM_MAX=8

# 0036: the camera, for .elf apps through the ABI's camera section. It
# runs under this firmware's configuration, so these are what
# feckless_camera's README asks of an application, as Unprofitable
# Mahjong's sdkconfig.defaults has them: the SC202CS, and the ISP's
# controller, without which the picture is near black; AWB and colour
# correction, without which the sensor's pipeline will not start; and
# Mahjong's tuning file, the default with its colour matrices the
# identity (camera/README.md), since apps want the grey. Avoidant itself
# never opens the camera.
CONFIG_CAMERA_SC202CS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ESP_IPA_AWB_ALGORITHM=y
CONFIG_ESP_IPA_ACC_ALGORITHM=y
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="camera/sc202cs_ipa.json"

# 0041: the network, for .elf apps through the ABI's network section
# (feckless-libs' 6004). It runs under this firmware's configuration, so
# these are what feckless_network_handler's README asks of an
# application, as Errant Moving Map's sdkconfig.defaults has them (and
# Defeatist's, where each is argued at length). Avoidant itself does not
# start the network; an app's wifi_init() does.
#
# wifi.c powers the C6 through the expander and calls esp_hosted_init()
# itself; a pre-main init would find the module unpowered. The board
# preset, and the C6's EN on GPIO15. The C6's firmware sends
# streaming-framed reads.
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=15
CONFIG_ESP_HOSTED_HOST_SDIO_RX_STREAMING_MODE=y
# wifi.c asks for three NIST servers; the array is sized by this.
CONFIG_LWIP_SNTP_MAX_SERVERS=3
# TLS, lwIP and the transport's staging buffers out of internal RAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y
# What the network section holds both sides to that is not IDF's
# default: WebSockets, for Defeatist's remote. And the hardware ECDSA
# signer off, as the section has it and Errant writes down.
CONFIG_HTTPD_WS_SUPPORT=y
# 0046: and esp_https_server, which builds nothing unless this is set.
# The network section's feckless_https_start() (feckless-libs 8004) is
# httpd_ssl_start() with the device's own certificate, kept here for
# every app; without this it does not link, and feckless_abi_network says
# so at configure time. rm sdkconfig before building. The line that
# proves it took is the first app's `feckless_https: made a certificate
# for feckless-xxxxxx` (and `answering mDNS as feckless-xxxxxx.local`).
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_HARDWARE_ECDSA_SIGN=n
# 0044: and the verifier off too, as Errant and Defeatist have it: the
# P4's ECDSA peripheral is not on silicon before v3, and every TLS
# handshake an app made through this firmware logged "E
# psa_crypto_driver_esp_ecdsa: ECDSA peripheral not supported on this
# chip revision" before falling back to software.
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=n
# Every app's sockets are this firmware's: Defeatist wants 28 (its
# sdkconfig.defaults), the section recommends 16 at least.
CONFIG_LWIP_MAX_SOCKETS=28
